msgstr "Noch keine Beziehungen."

#: src/shared/RelationsEditor.jsx
msgid "Move up"
msgstr "Nach oben"

#: src/shared/RelationsEditor.jsx
msgid "Move down"
msgstr "Nach unten"

#: src/shared/RelationsEditor.jsx
