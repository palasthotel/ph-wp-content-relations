msgstr "Nach unten"

#: classes/relations-i18n.php:25 classes/types-screen.php:215
msgid "Remove"
msgstr "Entfernen"

#: classes/relations-i18n.php:27
msgid "Pick a type or type a new name."
msgstr "Einen Typ wählen oder einen neuen Namen eingeben."

#: classes/relations-i18n.php:28
msgid "Choose a relation type first."
msgstr "Wähle zuerst einen Beziehungstyp."

#: classes/relations-i18n.php:29
msgid "Add a related post"
msgstr "Verwandten Inhalt hinzufügen"

#: classes/relations-i18n.php:30
msgid "Search posts…"
msgstr "Inhalte suchen…"

#: classes/relations-i18n.php:31
msgctxt "post search"
msgid "No posts found."
msgstr "Keine Inhalte gefunden."

#. translators: %s is replaced with the typed name in the browser, not by PHP
#: classes/relations-i18n.php:33
#, php-format
msgid "Create \"%s\""
msgstr "„%s“ anlegen"

#: classes/relations-i18n.php:35
msgctxt "block editor"
msgid "Related content"
msgstr "Verwandte Inhalte"

#: classes/relations-i18n.php:36
msgctxt "block editor"
msgid ""
"Posts this post relates to, under one relation type, in their saved order."
msgstr ""
"Beiträge, mit denen dieser Beitrag über einen Beziehungstyp verknüpft ist, "
"in der gespeicherten Reihenfolge."

#: classes/relations-i18n.php:37
msgctxt "block editor"
msgid "Relation type"
msgstr "Beziehungstyp"

#: classes/relations-i18n.php:38
msgctxt "block editor"
msgid "Which of this post's relation types to list."
msgstr "Welcher Beziehungstyp dieses Beitrags aufgelistet werden soll."

#: classes/relations-i18n.php:39
msgctxt "block editor"
msgid "— Select —"
msgstr "— Auswählen —"

#: classes/rest-editor.php:161
msgid "You are not allowed to edit the relations of this post."
msgstr "Du darfst die Beziehungen dieses Inhalts nicht bearbeiten."

#: classes/rest-editor.php:169
msgid "Relations must be a list."
msgstr "Beziehungen müssen eine Liste sein."

#: classes/rest-editor.php:216
msgid "A type is required."
msgstr "Ein Typ ist erforderlich."

#: classes/types-list-table.php:36
msgctxt "list table"
msgid "Type"
msgstr "Typ"

#: classes/types-list-table.php:37
msgctxt "list table"
msgid "Relations"
msgstr "Beziehungen"

#: classes/types-list-table.php:50 classes/types-list-table.php:81
msgctxt "list table"
msgid "Delete"
msgstr "Löschen"

#: classes/types-list-table.php:75
msgctxt "list table"
msgid "Edit"
msgstr "Bearbeiten"

#: classes/types-list-table.php:80
msgid "Delete this relation type and every relation of it?"
msgstr "Diesen Beziehungstyp und alle seine Beziehungen löschen?"

#: classes/types-list-table.php:98
msgid "No relation types yet. They appear here once a relation is created."
msgstr ""
"Noch keine Beziehungstypen. Sie erscheinen hier, sobald eine Beziehung "
"angelegt wird."

#: classes/types-screen.php:214
msgid "Drag to reorder"
msgstr "Ziehen, um die Reihenfolge zu ändern"

#: classes/types-screen.php:216
msgid "Save order"
msgstr "Reihenfolge speichern"

#: classes/types-screen.php:217
msgid "Reset"
msgstr "Zurücksetzen"

#: classes/types-screen.php:218
msgid "Order saved."
msgstr "Reihenfolge gespeichert."

#: classes/types-screen.php:219
msgid "Saving failed."
msgstr "Speichern fehlgeschlagen."

#: classes/types-screen.php:220
msgid "This type has no relations."
msgstr "Dieser Typ hat keine Beziehungen."

#. translators: %s: number of deleted relations
#: classes/types-screen.php:302
#, php-format
msgid "%s relation deleted."
msgid_plural "%s relations deleted."
msgstr[0] "%s Beziehung gelöscht."
msgstr[1] "%s Beziehungen gelöscht."

#: classes/types-screen.php:318
msgid ""
"Relation types are created when a relation is added in the editor. Delete a "
"type here to remove it and every relation of it."
msgstr ""
"Beziehungstypen entstehen, wenn im Editor eine Beziehung angelegt wird. Hier "
"gelöscht, verschwindet der Typ samt all seiner Beziehungen."

#: classes/types-screen.php:321
msgid "Search types"
msgstr "Typen durchsuchen"

#. translators: %s: relation type name
#: classes/types-screen.php:340
#, php-format
msgid "Edit relation type: %s"
msgstr "Beziehungstyp bearbeiten: %s"

#: classes/types-screen.php:346
msgid "Back to types"
msgstr "Zurück zu den Typen"
