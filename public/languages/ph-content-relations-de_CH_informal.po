#. Plugin Name of the plugin
#: ph-content-relations.php
msgid "Content Relations"
msgstr "Content Relations"

#. Plugin URI of the plugin
#: ph-content-relations.php
msgid "https://wordpress.org/plugins/content-relations/"
msgstr ""

#. Description of the plugin
#: ph-content-relations.php
msgid ""
"Relate posts to other posts, with a meta box in the editor and the relations "
"exposed on the REST API."
msgstr ""
"Inhalte mit anderen Inhalten verknüpfen – mit einer Metabox im Editor und "
"den Beziehungen in der REST-API."

#. Author of the plugin
#: ph-content-relations.php
msgid ""
"Palasthotel <rezeption@palasthotel.de> (Edward Bock, Jana Marie Eggebrecht)"
msgstr ""

#. Author URI of the plugin
